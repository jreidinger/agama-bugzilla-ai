# Secrets and authentication tokens (NEVER commit these)
secrets/*
!secrets/*.example
!secrets/*.example.txt
!secrets/README.md
*.token
*.key
.env
.env.*
!.env.example

# Temporary and runtime files
*.log
tmp/
.DS_Store

# Runtime MCP configurations generated by runners (contains injected auth headers)
workspace/.gemini/settings.json
!workspace/.gemini/settings.json.example
workspace/.mcp.json
!workspace/.mcp.json.example

# Gemini CLI runtime artifacts
workspace/.gemini/tmp/
workspace/.gemini/history/
workspace/.gemini/cache/
